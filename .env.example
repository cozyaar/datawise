# ==========================================
# DataWise Environment Variables Configuration
# ==========================================

# 1. PostgreSQL Connection Strings
# Primary administrative connection (used for migrations, seeds, recording sessions & scenarios)
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/datawise

# Restricted Read-Only Connection (used exclusively for executing AI-generated analytical queries)
# Role created in migrations/001_init.sql with strictly SELECT-only privileges
DATABASE_READONLY_URL=postgresql://datawise_readonly:datawise_read_only_pass@127.0.0.1:5432/datawise

# 2. LLM Provider Configuration (Google Gemini)
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# 3. Execution & Simulation Settings
# If set to true, or if GEMINI_API_KEY is not provided, the application uses an intelligent
# built-in offline analytical query planner so evaluation/testing can proceed seamlessly.
DEMO_MODE=false

# Analytical Safety Constraints
MAX_QUERY_ROWS=100
QUERY_TIMEOUT_MS=6000
